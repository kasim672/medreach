# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/medreach

# Auth
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_NEVER_COMMIT_REAL_VALUE
JWT_EXPIRES_IN=1h

# CORS - comma-separated list of allowed frontend origins (one per variant)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
