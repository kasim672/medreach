[Unit]
Description=MedReach %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=medreach
Group=medreach
WorkingDirectory=/opt/medreach
EnvironmentFile=/etc/medreach/runtime.env
ExecStart=/usr/bin/bash /opt/medreach/backend/operations/oracle/run-role.sh %i
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=medreach
Environment=TMPDIR=/var/lib/medreach
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
