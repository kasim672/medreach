{
  "name": "medreach-backend",
  "version": "1.0.0",
  "description": "Shared Express + MongoDB backend for MedReach - the single independent-variable-controlled backend used identically by all frontend framework variants (Bootstrap, Tailwind, Skeleton, React component arm).",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "mongoose": "8.9.5",
    "jsonwebtoken": "9.0.2",
    "bcrypt": "5.1.1",
    "express-validator": "7.2.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "cors": "2.8.5",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "morgan": "1.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "10.1.2"
  }
}
